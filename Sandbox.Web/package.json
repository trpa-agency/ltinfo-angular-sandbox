{
  "name": "sandbox-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.dev.json",
    "start:docker": "ng serve --host 0.0.0.0 --port 4200 --poll 1000 --proxy-config proxy.conf.docker.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "export:static": "node scripts/export-static-api.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
