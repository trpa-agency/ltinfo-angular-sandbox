# The nginx image renders this file to /etc/nginx/conf.d/default.conf when the
# container starts, filling in ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS}
# from the environment. Every other $name below is an nginx variable.

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Look the API up by name on each request instead of once at startup. That
  # way this container starts, and the app shows its own error state, even
  # when the API container is not running yet.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $api_upstream ${API_UPSTREAM};

  # The reverse proxy: /api/health here becomes /health on the API. The dev
  # server does the same job with proxy.conf.docker.json.
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://$api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Always ask for a fresh index.html, so a new build shows up on reload.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # SPA fallback: a path that is not a file (/programs/41) is an Angular
  # route, so serve the app and let the router take it from there.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
