# Copy to .env (same folder) and fill in. .env is gitignored and never committed.

# Running the SQL Server container means accepting Microsoft's license for it:
# https://go.microsoft.com/fwlink/?LinkId=746388
# Set to Y once you have read and accepted it.
ACCEPT_EULA=

# Password for the sa login inside the container. At least 8 characters with upper
# case, lower case, a digit, and a symbol. Avoid $ and quotes.
SA_PASSWORD=

DB_NAME=LTInfoSandbox
