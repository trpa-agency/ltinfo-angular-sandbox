# Copy to .env (same folder) and fill in. .env is gitignored and never committed.

# How containers reach the SQL Server installed on this machine.
DB_SERVER=host.docker.internal
DB_NAME=LTInfoSandbox

# The SQL login the API signs in with. Build\DatabaseBuild.ps1 creates it with this
# password and limits it to reading and writing DB_NAME. Pick any strong password:
# at least 8 characters with upper case, lower case, a digit, and a symbol.
# Avoid $, ;, and quotes.
SQL_USER=SandboxWebUser
SQL_PASSWORD=
